 // 谁能跟她说话、她在每个会话里有多大权限。纯函数。
 
 /** 权限档位：full = DSH 完整工具；social = 只有 QQ 社交工具；chat = 纯聊天，没有工具。 */
+// 对外只有两档：full = 能指挥干活，social = 只能聊天。
+// 'chat' 保留是为了兼容老配置（以前的三档），面板里已经不再提供。
 export const LEVELS = ['full', 'social', 'chat']
 
 /**
@@ -26,8 +28,15 @@ export function checkAllowed(cfg, msg) {
 /** 这个会话用哪一档权限。群聊永远不超过 social。 */
 export function levelFor(cfg, chat) {
   const owner = String(cfg.ownerQQ || '')
-  if (chat.kind === 'private' && chat.userId === owner) {
-    return LEVELS.includes(cfg.ownerLevel) ? cfg.ownerLevel : 'full'
+  if (chat.kind === 'private') {
+    if (chat.userId === owner) return LEVELS.includes(cfg.ownerLevel) ? cfg.ownerLevel : 'full'
+    // 私聊白名单里的人走 whitelistLevel（面板「白名单的权限」），默认给能指挥干活。
+    // 白名单本身就是准入闸门；要收回来，把这一段的 return 改成 'social' 就行。
+    // 面板上的「白名单的权限」就是这个，只有两档：能指挥干活 / 只能聊天。
+    const list = (cfg.allow?.private || []).map(String)
+    if (list.includes(String(chat.userId))) {
+      return LEVELS.includes(cfg.whitelistLevel) ? cfg.whitelistLevel : 'full'
+    }
   }
   return 'social'
 }
